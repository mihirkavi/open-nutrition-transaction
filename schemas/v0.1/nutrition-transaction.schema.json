{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mihirkavi/open-nutrition-transaction/blob/v0.1.0/schemas/v0.1/nutrition-transaction.schema.json",
  "title": "Open Nutrition Transaction 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["nutrition_transaction_version", "transaction_id", "merchant", "consumption_status", "currency", "items", "nutrition_total"],
  "properties": {
    "nutrition_transaction_version": { "const": "0.1" },
    "transaction_id": { "type": "string", "minLength": 1 },
    "merchant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "location_id": { "type": "string", "minLength": 1 }
      }
    },
    "purchased_at": { "type": "string", "format": "date-time" },
    "consumption_status": { "enum": ["purchased", "assumed_consumed", "user_confirmed_consumed", "partially_consumed", "shared", "unknown"] },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } },
    "nutrition_total": { "$ref": "#/$defs/nutrients" },
    "nutrition_total_range": { "$ref": "#/$defs/ranges" }
  },
  "$defs": {
    "nutrientKey": { "enum": ["energy_kcal", "protein_g", "carbohydrate_g", "total_fat_g", "saturated_fat_g", "trans_fat_g", "fiber_g", "total_sugars_g", "added_sugars_g", "sodium_mg", "cholesterol_mg"] },
    "nutrients": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/nutrientKey" },
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": { "min": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } }
    },
    "ranges": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/nutrientKey" },
      "additionalProperties": { "$ref": "#/$defs/range" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id", "source_name"],
      "properties": {
        "source_type": { "enum": ["restaurant_verified", "restaurant_published", "recipe_registry", "usda_fdc", "open_food_facts", "external_recipe", "ai_recipe_assumption"] },
        "source_id": { "type": "string", "minLength": 1 },
        "source_name": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "ingredient_name": { "type": "string", "minLength": 1 },
        "quantity_grams": { "type": "number", "exclusiveMinimum": 0 },
        "nutrient_values": { "$ref": "#/$defs/nutrients" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "quantity", "nutrition", "nutrition_status", "confidence", "source_method", "assumptions", "provenance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "financial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit_price", "currency"],
          "properties": { "unit_price": { "type": "number", "minimum": 0 }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" } }
        },
        "nutrition": { "$ref": "#/$defs/nutrients" },
        "nutrition_range": { "$ref": "#/$defs/ranges" },
        "nutrition_status": { "enum": ["verified", "high_confidence", "estimated", "low_confidence", "unresolved"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_method": { "type": "string", "minLength": 1 },
        "recipe_version": { "type": "string", "minLength": 1 },
        "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" } }
      }
    }
  }
}
